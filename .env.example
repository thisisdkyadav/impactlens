# Optional live vision analysis and semantic embeddings.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Use true behind an HTTPS reverse proxy; set APP_ORIGIN to the public origin.
SECURE_COOKIES=false
