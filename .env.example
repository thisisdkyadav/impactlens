PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./data
DEMO_MODE=true
# Change before exposing the application beyond localhost.
ADMIN_EMAIL=admin@impactlens.local
ADMIN_PASSWORD=ImpactLens!2026
# Live Cloudinary uploads (all three required).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
